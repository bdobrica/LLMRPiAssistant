# RPI Assistant Configuration
# This file takes precedence over environment variables.
# Remove or comment out any settings you want to control via environment variables.

[audio]
# Audio device configuration
sample_rate = 16000
# 80ms @ 16kHz
chunk_size = 1280
# Number of input channels
channels = 4
# Which channel to use (0-3)
mic_channel_index = 0
# Substring to match audio device name
device_match = seeed
# Maximum live audio buffered between the device callback and recorder loop.
# Lower drops stale audio sooner; higher tolerates brief CPU spikes.
queue_seconds = 5.0

[wakeword]
# Wake word detection settings
# Detection threshold (0.0-1.0, higher = less sensitive)
threshold = 0.5
# Minimum time between wake word detections
cooldown_seconds = 1.0

# Comma-separated list of wake word models to load
# Empty or omitted selects hey_jarvis only to limit memory use.
# Example models: hey_jarvis, alexa, hey_mycroft, hey_rhasspy
# Use fewer models to reduce memory usage on limited devices
# models = hey_jarvis
models =

[recording]
# Voice recording settings
# Maximum recording length
max_duration_seconds = 10.0
# Stop recording after this much silence
silence_hold_seconds = 0.8
# RMS level below which is considered silence
# Lower = more sensitive, stops on quieter sounds
# Higher = less sensitive, needs louder silence
# Typical values: 0.005 (very sensitive) to 0.02 (less sensitive)
silence_rms_threshold = 0.007
# How much audio to capture before wake word
pre_roll_seconds = 0.4
# How long to keep dropping stale audio after command processing/TTS before
# resuming wake-word detection
processing_drain_seconds = 3.0
# After successful spoken playback: listen without a wake word for this long.
# Set to 0 to disable. Steady green LEDs mark this window; silence closes it.
follow_up_window_seconds = 6.0
# Drop residual speaker audio before opening the window.
follow_up_echo_guard_seconds = 0.35
# Optional button: BCM GPIO17 on the ReSpeaker 2-Mics HAT; -1 disables it.
# Press during spoken answers, wait for green, then speak a correction.
interrupt_button_gpio = -1
# Correction window also works when ordinary follow-up listening is disabled.
correction_window_seconds = 6.0
# Where to save recorded audio
output_path = /tmp/command.wav

[openai]
# OpenAI API configuration
# Set here, via OPENAI_API_KEY, or using the trusted-LAN phone Settings page.
# Local controls/checks can start without a key; voice requests require one.
api_key = 

# Recorded-speech transcription (legacy setting name retained)
whisper_model = gpt-transcribe

# Chat completion settings
# Chat and intent model; none is required for Luna Chat Completions tools.
chat_model = gpt-6-luna
reasoning_effort = none

# Realtime speech generates WAV, keeping the existing voice.
tts_backend = realtime
tts_model = gpt-realtime-2.1-mini
tts_voice = alloy
# HTTP network-operation timeout; automatic API retries are disabled.
request_timeout_seconds = 20
# Optional hosted current-information lookup using chat_model and the existing key.
# Read-only Responses web_search; up to two hosted tool calls per lookup (paid).
web_search_enabled = true
# Realtime provider time budget, excluding local speaker backpressure.
tts_timeout_seconds = 30
# Maximum tokens in response
max_tokens = 500
# Response creativity (0.0-2.0)
temperature = 0.7
# Reset active chat context if this many seconds pass after the last spoken response.
# Set to 0 to disable idle context resets.
conversation_idle_timeout_seconds = 300.0
# If prior context relevance is below this score (0.0-1.0), reset active chat context.
conversation_relevance_threshold = 0.35
# Retain whole recent exchanges; no inactive archive or summarization calls.
conversation_max_turns = 32
# UTF-8 JSON bytes, excluding the fixed system prompt; minimum 1024.
conversation_max_bytes = 262144

# System prompt for the assistant
system_prompt = You are a helpful voice assistant running on a Raspberry Pi. Provide concise, friendly responses suitable for voice interaction.

[led]
# LED configuration
# Number of LEDs (12 for ReSpeaker 4-Mic Array, 3 for 2-Mic pHAT)
count = 12

[audio_output]
# Audio output configuration for TTS playback
# Start speaking as Realtime audio arrives. False uses the completed WAV.
stream_realtime = true
# Enable/disable audio output
enabled = true
# ReSpeaker 2-Mic v1 PCM configured by make install-voicecard (32-bit playback).
# For other audio hardware choose its ALSA card name or "default".
device = assistant_wm8960
# Where to save TTS response audio file
tts_output_path = /tmp/response.wav

[logging]
# Logging configuration
# Conversation content stays out of console/journal even when file logging is enabled.
# Phone Settings can opt into private file content; deletion is a separate action.
conversation_logging = false
retention_days = 7
max_bytes = 1048576
# Where to save interaction logs
log_file = openai_interactions.log
# Logging level (DEBUG, INFO, WARNING, ERROR)
log_level = INFO

[rpiface]
# Optional deterministic face lifecycle integration. Disabled by default.
# Environment equivalents: RPIFACE_ENABLED, RPIFACE_BASE_URL,
# RPIFACE_TIMEOUT_SECONDS.
enabled = false
base_url = http://127.0.0.1:8765
# Must be greater than zero and less than one second. Calls run off the audio path.
timeout_seconds = 0.3

[mcp]
# Optional generic MCP tool support. Disabled until explicitly enabled.
enabled = false
timeout_seconds = 30
# Maximum model -> tool -> model cycles per assistant response (1-10).
max_tool_rounds = 3
# Comma-separated names whose settings live in [mcp.server.<name>] sections.
servers = rpiface

[mcp.server.rpiface]
# stdio servers require command; args is a JSON array (or comma-separated list).
transport = stdio
command = /opt/venvs/rpiface/bin/rpiface-mcp
args = []
# Only explicitly named environment variables are inherited by the child.
env_vars =

# Streamable HTTP alternative:
# transport = streamable-http
# url = http://127.0.0.1:8766/mcp
# token_env = RPIFACE_MCP_ACCESS_TOKEN

[app_store]
# Default remote repository root used for named app installs like "install app dice"
default_repository_url = https://raw.githubusercontent.com/bdobrica/LLMRPiAssistant/main/voice_apps/
# Keep the checked-out local voice_apps directory as a fallback when running from source
use_local_repository_fallback = true
# Optional Base64-encoded Ed25519 public key used to verify signed repository catalogs.
# If left empty, the assistant uses the shipped value from voice_apps/public_key.txt.
trusted_public_key =
# Require repository catalogs to be signed. Remote repositories are always
# required to be signed unless this is explicitly set to false in local config.
require_signature = true

[controls]
# Settings include write-only provider keys and local microphone/speaker checks.
# Settings → Advanced mirrors the parsed INI. Sign in as admin with the device setup code.
# Removing a file override restores environment/default precedence.
# Save & apply is explicit; the private config.ini.phone-undo.json supports undo.
# Phone page: host = lan binds connected private IPv4 LAN addresses only.
# Open http://<device-IP>/ (literal IP). Closed during Wi-Fi setup.
# Port 80 requires the installed systemd service; do not run the assistant as root.
# For terminal-only development use host = 127.0.0.1 and port = 8767.
# Everyday controls are shared on that LAN. Settings writes require the device code.
# Use a trusted network; HTTP does not encrypt submitted API keys.
enabled = true
host = lan
port = 80
mixer_card = seeed2micvoicec
# Speaker for the wired HAT speaker; Headphone for its 3.5 mm output.
mixer_control = Speaker
# Saved mute preference; survives restart. Volume uses the current ALSA setting.
state_path = ~/.local/state/rpi-assistant/controls.json

[timers]
# Persistent local countdowns; microphone mute does not silence alerts.
state_path = ~/.local/state/rpi-assistant/timers.sqlite3
# Repeat the local chime for up to this many seconds, then show a missed timer.
alert_seconds = 120

[household]
# IANA timezone for reminder interpretation and display; restart after changes.
# Existing reminders keep their scheduled UTC instant when this is changed.
timezone = Europe/Bucharest
state_path = ~/.local/state/rpi-assistant/household.sqlite3

[weather]
# Optional home override, e.g. Bucharest, Romania. Overrides saved spoken/IP city.
city =
# Optional precise coordinates require city and timezone; otherwise city is geocoded.
latitude =
longitude =
# Blank uses the resolved city's zone, independently of reminder timezone.
timezone =
timeout_seconds = 8
# Optional paid Open-Meteo key selects customer-api.open-meteo.com automatically.
# Free endpoint is for non-commercial use; commercial products need a subscription.
api_key =
# Optional opt-in IP city detection when there is no configured/saved spoken city.
# Without this key, the first weather request asks for a city and remembers it.
ipgeolocation_api_key =
state_path = ~/.local/state/rpi-assistant/weather-location.json
